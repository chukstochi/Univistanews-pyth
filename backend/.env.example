# Copy this file to .env and fill in real values. Never commit .env to git.

# MySQL connection
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=univista_news

# Flask
# Generate each of these with: python -c "import secrets; print(secrets.token_hex(32))"
# Use a DIFFERENT value for each one. Never reuse the values from this example file.
SECRET_KEY=
JWT_SECRET_KEY=

# The URL your frontend is served from in production (used for CORS).
# Example: https://www.yourdomain.com
FRONTEND_ORIGIN=http://localhost:5173

# Used ONLY by the one-time seed script (see seed_admin.py).
# Set a real admin email and a strong, unique password here, run the seed
# script once, then blank BOTH of these out again immediately.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
